# Frontend (Vite) configuration.
#
# Copy to .env.local for local development, or set these in the Vercel
# dashboard for a deployment. Vite only exposes variables prefixed VITE_,
# and it inlines them into the built bundle - so nothing secret belongs here.

# Base URL of the backend API. src/services/apiClient.js normalises this in
# one place: it strips trailing slashes and appends the /api path segment when
# the value does not already end in /api, so the host on its own works too.
# Production example: https://iunu-backend.up.railway.app/api
VITE_API_URL=http://localhost:8080/api
