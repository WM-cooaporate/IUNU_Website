# The lab's stand-in for the edge (Cloudflare in production).
#
# - Appends the peer address to X-Forwarded-For, the way Render's proxy does,
#   so the backend's x-forwarded-for mode and TRUSTED_PROXIES are exercised
#   for real (abuse.js's spoofing check, BEHIND_PROXY=yes).
# - Injects X-Edge-Auth, the way the Cloudflare Transform Rule in
#   docs/DDOS_RUNBOOK.md does, so a request that skips this hop is refused.
# - Streams request bodies instead of buffering them. nginx's default would
#   turn a chunked upload into one with a Content-Length, hiding the M2
#   residual this lab is meant to measure; Cloudflare streams too.
server {
    listen 80;
    server_tokens off;

    # Above every limit the backend enforces, so the backend's own 413 is what
    # gets tested rather than nginx's.
    client_max_body_size 64m;

    location / {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Edge-Auth "${LAB_EDGE_SECRET}";
    }
}
