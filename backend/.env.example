# Copy this file to .env (or set these as real environment variables /
# secrets in your deployment platform) and fill in real values.
# NEVER commit an actual .env file.

# --- Database ---------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/iunu_real_estate?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=false
DB_USERNAME=iunu_app
DB_PASSWORD=change-me

# --- JWT ----------------------------------------------------------------
# Required. Must be a random string of at least 32 bytes.
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_ISSUER=iunu-real-estate-api

# --- CORS / frontend ------------------------------------------------------
# Comma-separated list of origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
UPLOAD_LOCATION=uploads
PUBLIC_API_URL=http://localhost:8080

# --- Account security -----------------------------------------------------
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=15
RESET_TOKEN_EXPIRY_MINUTES=30
REFRESH_TOKEN_EXPIRY_DAYS=7

# Only set to true if this app sits behind a reverse proxy you trust to set
# X-Forwarded-For correctly (otherwise clients could spoof it to dodge rate limits).
TRUST_FORWARDED_HEADER=false

# --- Outbound email (password reset) ---------------------------------------
# Leave MAIL_ENABLED=false for local dev - reset links are logged instead of emailed.
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@iunu-eg.com

# --- One-time admin bootstrap -----------------------------------------------
# Set both to create the first ADMIN user on next startup, then unset them.
# Only takes effect while the database contains no ADMIN at all, so leaving
# these set cannot add further admins - use POST /api/admin/users for that.
# ADMIN_PASSWORD must be at least 8 characters or the account is not created.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Misc --------------------------------------------------------------
SERVER_PORT=8080
